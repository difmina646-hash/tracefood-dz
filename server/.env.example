# ── TraceFood DZ — server environment ─────────────────────────────
# Copy this file to ".env" (same folder) and adjust. NEVER commit ".env".

# MySQL connection. With default XAMPP: user "root", EMPTY password, port 3306.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/tracefood_dz"

# Secret used to sign login tokens. Use 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_to_a_long_random_value_at_least_32_chars"

PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma separated).
CLIENT_ORIGIN="http://localhost:5173"

# Public URL of the web app — written inside QR codes (https://<domain>/q/<id>).
# For phone scanning on your local Wi-Fi use your PC IP, e.g. http://192.168.1.20:5173
PUBLIC_BASE_URL="http://localhost:5173"

# Where uploaded documents are stored (outside the web root, never served directly).
UPLOAD_DIR="./uploads"

# Password given to ALL demo accounts by the seed script. Demo/local use only.
# The seed refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="Demo@12345"
